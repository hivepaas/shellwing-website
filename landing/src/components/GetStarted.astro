---
// GetStarted.astro - the download: one button for the visitor's system, then a
// tab for each system with its files, how to install them and the first
// launch. Without JavaScript every system shows, one under the other.
import { GITHUB_URL, PLATFORMS_DOC_URL } from '../data/site';
import { VERSION, RELEASE_URL, systems, comingSoon } from '../data/downloads';

const icons: Record<string, string> = {
  macos:
    'M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.8-3-.8-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.8zM14.1 5.8c.6-.8 1.1-1.8 1-2.8-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.7-1 2.7 1 .1 2.1-.5 2.7-1.3z',
  windows: 'M3 5.5l7.4-1v7.1H3zm0 13l7.4 1v-7H3zm8.3 1.1L21 21v-8.4h-9.7zm0-15.2v7.2H21V3z',
  linux:
    'M12 2c-2.2 0-3.6 1.9-3.6 4.6 0 1.4.4 2.4.1 3.4-.4 1.3-2.6 3.4-3.1 6-.2 1 .1 1.6.6 1.9-.3.7-.1 1.5.7 1.8 1.1.5 2.4.6 3.4 1.3.9.6 1.9.6 2.6-.2.7.7 1.7.8 2.6.2 1-.7 2.3-.8 3.4-1.3.8-.3 1-1.1.7-1.8.5-.3.8-.9.6-1.9-.5-2.6-2.7-4.7-3.1-6-.3-1 .1-2 .1-3.4C15.6 3.9 14.2 2 12 2z',
  android:
    'M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 1.23 12.95 1 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 3.26 6 5.01 6 7h12c0-1.99-.97-3.75-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z',
};
icons.ios = icons.macos;

const tabsOf = [...systems, ...comingSoon];
---

<section class="section" id="get">
  <div class="container">
    <div class="dl">
      <div class="dl-glow" aria-hidden="true"></div>

      <div class="dl-head">
        <span class="section-tag">Download</span>
        <h2 class="dl-title">
          <span class="text-gradient-white">Get shellwing</span>
          <span class="text-gradient-sky"> {VERSION}</span>
        </h2>
        <p class="dl-desc">
          Free and open source, for macOS, Windows and Linux; iOS and Android are coming soon. It tells you when a new
          version is out and installs it when you say so.
        </p>

        <div class="dl-main" id="dlMain">
          {
            systems.map((os) => {
              const primary = os.downloads.find((d) => d.primary)!;
              return (
                <div class="dl-pick" data-os={os.id} hidden={os.id !== 'macos'}>
                  <a href={primary.href} class="btn btn-primary btn-lg">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={icons[os.id]} />
                    </svg>
                    Download for {os.name}
                  </a>
                  <span class="dl-pick-note">
                    {primary.label} · {primary.note}
                  </span>
                </div>
              );
            })
          }
          {
            comingSoon.map((os) => (
              <div class="dl-pick" data-os={os.id} hidden>
                <span class="btn btn-lg soon-badge">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={icons[os.id]} />
                  </svg>
                  {os.name}: coming soon
                </span>
                <span class="dl-pick-note">For now, shellwing runs on macOS, Windows and Linux.</span>
              </div>
            ))
          }
        </div>
        <p class="dl-links">
          <a href={RELEASE_URL} target="_blank" rel="noopener noreferrer">Release notes</a>
          <span aria-hidden="true">·</span>
          <a href={RELEASE_URL} target="_blank" rel="noopener noreferrer">All files and SHA-256</a>
          <span aria-hidden="true">·</span>
          <a href={PLATFORMS_DOC_URL} target="_blank" rel="noopener noreferrer">Build from source</a>
        </p>
      </div>

      <div class="tabs" role="tablist" aria-label="System">
        {
          tabsOf.map((os, i) => (
            <button
              type="button"
              role="tab"
              class="tab"
              id={`tab-${os.id}`}
              aria-controls={`panel-${os.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-os={os.id}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={icons[os.id]} />
              </svg>
              {os.name}
            </button>
          ))
        }
      </div>

      {
        systems.map((os) => (
          <div class="panel" role="tabpanel" id={`panel-${os.id}`} aria-labelledby={`tab-${os.id}`} data-os={os.id}>
            <div class="files">
              <h3 class="panel-title">{os.name}</h3>
              <p class="requires">{os.requires}</p>
              <ul class="file-list">
                {os.downloads.map((d) => (
                  <li>
                    <a href={d.href} class:list={['file', { primary: d.primary }]}>
                      <span class="file-text">
                        <span class="file-label">{d.label}</span>
                        <span class="file-note">{d.note}</span>
                      </span>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                        <path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="howto">
              <h4>Install</h4>
              <ol class="steps">
                {os.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
              {os.commands && (
                <div class="cmd">
                  <button type="button" class="copy" data-copy={os.commands}>
                    Copy
                  </button>
                  <pre>{os.commands}</pre>
                </div>
              )}
              <div class="first-run">
                <strong>First launch.</strong> {os.firstRun}
              </div>
            </div>
          </div>
        ))
      }

      {
        comingSoon.map((os) => (
          <div class="panel panel-soon" role="tabpanel" id={`panel-${os.id}`} aria-labelledby={`tab-${os.id}`} data-os={os.id}>
            <h3 class="panel-title">{os.name} <span class="soon">Coming soon</span></h3>
            <p class="soon-text">{os.text}</p>
          </div>
        ))
      }

      <p class="dl-foot">
        Like it? <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">Star shellwing on GitHub</a> to follow
        what comes next.
      </p>
    </div>
  </div>
</section>

<style>
  .dl {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 28px;
    border: 1px solid rgba(56, 189, 248, 0.25);
    background: linear-gradient(150deg, rgba(56, 189, 248, 0.1), rgba(12, 17, 26, 0.85) 45%, rgba(167, 139, 250, 0.08));
  }

  .dl-glow {
    position: absolute;
    top: -40%;
    left: 20%;
    width: 60%;
    height: 90%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.16), transparent 60%);
    pointer-events: none;
  }

  .dl-head {
    position: relative;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .dl-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .dl-desc {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .dl-pick {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .dl-pick[hidden] {
    display: none;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 1.05rem;
    border-radius: 14px;
  }

  .dl-pick-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .dl-links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.75rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .dl-links a {
    text-decoration: none;
  }

  .dl-links a:hover {
    text-decoration: underline;
  }

  .tabs {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--text-primary);
  }

  .tab[aria-selected='true'] {
    color: #04121c;
    background: var(--accent);
    border-color: var(--accent);
  }

  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: var(--card-pad);
    border-radius: 20px;
    border: 1px solid var(--border-card);
    background: rgba(4, 6, 10, 0.6);
  }

  .panel + .panel {
    margin-top: 1rem;
  }

  .panel[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 1fr 1.1fr;
      gap: 2.5rem;
    }
  }

  @media (min-width: 900px) {
    .panel.panel-soon {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .panel-soon {
    gap: 0.5rem;
    text-align: center;
  }

  .soon {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    vertical-align: middle;
    color: var(--accent-amber);
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .soon-text {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--text-secondary);
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.03);
  }

  .panel-title {
    font-size: 1.3rem;
    font-weight: 800;
  }

  .requires {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0.25rem 0 1.1rem;
  }

  .file-list {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .file {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .file:hover {
    border-color: var(--border-hover);
    background: rgba(56, 189, 248, 0.07);
  }

  .file.primary {
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.08);
  }

  .file svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  .file-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
  }

  .file-label {
    font-weight: 700;
  }

  .file-note {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .howto {
    min-width: 0;
  }

  .howto h4 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 2.1rem;
    color: var(--text-secondary);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05rem;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-light);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .cmd {
    position: relative;
    margin-bottom: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border-card);
    background: rgba(0, 0, 0, 0.5);
  }

  .cmd pre {
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.7;
    color: #e2e8f0;
    overflow-x: auto;
  }

  .copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 7px;
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--text-primary);
  }

  .first-run {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border-left: 3px solid var(--accent-amber);
    background: rgba(251, 191, 36, 0.06);
  }

  .first-run strong {
    color: var(--accent-amber);
  }

  .dl-foot {
    position: relative;
    margin-top: 2rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>

<script>
  type Os = 'macos' | 'windows' | 'linux' | 'ios' | 'android';

  // The visitor's system, as the browser says it; macOS when it does not.
  function detect(): Os {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const p = `${nav.userAgentData?.platform ?? ''} ${navigator.platform} ${navigator.userAgent}`.toLowerCase();
    if (p.includes('android')) return 'android';
    if (/iphone|ipod/.test(p)) return 'ios';
    if (p.includes('win')) return 'windows';
    if (p.includes('linux')) return 'linux';
    return 'macos';
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#get .tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('#get .panel')];
  const picks = [...document.querySelectorAll<HTMLElement>('#get .dl-pick')];

  function show(os: Os, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.os === os;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p) => (p.hidden = p.dataset.os !== os));
  }

  const mine = detect();
  picks.forEach((p) => (p.hidden = p.dataset.os !== mine));
  show(mine);

  tabs.forEach((tab, n) => {
    tab.addEventListener('click', () => show(tab.dataset.os as Os));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      show(tabs[(n + step + tabs.length) % tabs.length].dataset.os as Os, true);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('#get .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  });
</script>
