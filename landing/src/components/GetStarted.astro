---
// GetStarted.astro - how to get shellwing while there is no release: build it
// from source, then run it. The buttons become downloads once there is one.
import { GITHUB_URL, PLATFORMS_DOC_URL, CONTRIBUTING_URL } from '../data/site';
---

<section class="section" id="get">
  <div class="container">
    <div class="cta">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-copy">
        <span class="section-tag">Get shellwing</span>
        <h2 class="cta-title">
          <span class="text-gradient-white">Build it today.</span>
          <span class="text-gradient-sky"> Downloads are on the way.</span>
        </h2>
        <p class="cta-desc">
          shellwing has no release yet. It builds from source on macOS, Windows and Linux with Rust 1.95+ and Zig 0.16, which
          builds libghostty-vt. Star the repository to hear about the first release.
        </p>
        <div class="cta-actions">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.787 1.401 8.168L12 18.896l-7.335 3.869 1.401-8.168L.132 9.21l8.2-1.192z"></path>
            </svg>
            Star on GitHub
          </a>
          <a href={PLATFORMS_DOC_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Setup per platform</a>
        </div>
        <p class="cta-small">
          Found a bug or want a feature? <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener noreferrer">Open an issue</a>,
          or read <a href={CONTRIBUTING_URL} target="_blank" rel="noopener noreferrer">how to contribute</a>.
        </p>
      </div>

      <div class="cta-code" aria-label="Commands to build and run shellwing">
        <div class="code-bar"><span>Terminal</span></div>
        <pre><span class="dim"># clone and build a release for this computer</span>
<span class="pr">$</span> git clone https://github.com/hivepaas/shellwing
<span class="pr">$</span> cd shellwing && make build
<span class="dim">built dist/shellwing-linux-x86_64</span>

<span class="dim"># then, with it on your PATH as shellwing</span>
<span class="pr">$</span> shellwing                  <span class="dim"># the host list</span>
<span class="pr">$</span> shellwing user@host        <span class="dim"># straight to a host</span>
<span class="pr">$</span> shellwing --local          <span class="dim"># a shell on this computer</span></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 28px;
    border: 1px solid rgba(56, 189, 248, 0.25);
    background: linear-gradient(150deg, rgba(56, 189, 248, 0.1), rgba(12, 17, 26, 0.85) 45%, rgba(167, 139, 250, 0.08));
  }

  @media (min-width: 960px) {
    .cta {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cta-glow {
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 120%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18), transparent 60%);
    pointer-events: none;
  }

  .cta-copy,
  .cta-code {
    position: relative;
    min-width: 0;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .cta-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.1rem;
  }

  .cta-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .cta-small {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .cta-code {
    border-radius: 16px;
    border: 1px solid var(--border-card);
    background: rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .code-bar {
    padding: 0.6rem 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
  }

  pre {
    padding: 1.1rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: #e2e8f0;
    overflow-x: auto;
  }

  .pr {
    color: var(--accent);
  }

  .dim {
    color: #5b6b82;
  }
</style>
