---
// VaultSync.astro - the vault, and its sync through storage the user already
// has: a picture of devices, the encryption between, and the backends.

const backends = [
  { name: 'Synced folder', eg: 'iCloud Drive, Dropbox, OneDrive, Syncthing, a NAS' },
  { name: 'WebDAV', eg: 'Nextcloud, Synology, Koofr' },
  { name: 'S3-compatible', eg: 'AWS S3, Cloudflare R2, Backblaze B2, MinIO' },
  { name: 'Git repository', eg: 'GitHub, GitLab, Gitea, any private repo' },
];
---

<section class="section" id="sync">
  <div class="container sync-grid">
    <div class="sync-copy">
      <span class="section-tag">Vault & Sync</span>
      <h2 class="sync-title">
        <span class="text-gradient-white">Your hosts and secrets on every device.</span>
        <span class="text-gradient-sky"> Your storage, your keys.</span>
      </h2>
      <p class="sync-desc">
        Passwords, SSH keys, snippets, environments, config files and notes are kept in one encrypted vault. It syncs
        through storage you already have, encrypted end to end: the storage only ever sees ciphertext.
      </p>
      <ul class="check-list">
        <li>
          <strong>Unlock the way your system does.</strong> The keychain, Windows Hello, Touch ID or a passphrase, and it can
          lock itself when you step away.
        </li>
        <li>
          <strong>Lock the whole app when away.</strong> Its windows hide until your system says it is you: Touch ID,
          Windows Hello, or your login password on Linux.
        </li>
        <li>
          <strong>No account, no limits.</strong> Syncing through a folder, WebDAV, S3 or Git is free, for as many hosts as
          you have.
        </li>
        <li>
          <strong>A new device joins safely.</strong> Approve it from one that already syncs, or type the recovery key that
          always opens the vault.
        </li>
        <li>
          <strong>Keys in the vault.</strong> Generate or import SSH keys, sign in with them on every device without a
          passphrase prompt, and export them as OpenSSH files when another tool needs one.
        </li>
      </ul>
    </div>

    <div class="sync-visual" aria-hidden="true">
      <div class="devices">
        <div class="device">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <rect x="4" y="5" width="16" height="11" rx="1.5"></rect><path d="M2 19h20"></path>
          </svg>
          <span>MacBook</span>
        </div>
        <div class="device">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M9 20h6M12 16v4"></path>
          </svg>
          <span>Windows PC</span>
        </div>
        <div class="device">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <rect x="4" y="5" width="16" height="11" rx="1.5"></rect><path d="M2 19h20"></path>
          </svg>
          <span>Linux laptop</span>
        </div>
      </div>

      <div class="flow">
        <span class="flow-line"></span>
        <span class="lock">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          Encrypted on the device
        </span>
        <span class="flow-line"></span>
      </div>

      <div class="backends">
        {
          backends.map((b) => (
            <div class="backend">
              <span class="backend-name">{b.name}</span>
              <span class="backend-eg">{b.eg}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .sync-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .sync-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
    }
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }

  .sync-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.1rem;
  }

  .sync-desc {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .sync-visual {
    padding: 2rem;
    border-radius: 24px;
    border: 1px solid var(--border-card);
    background:
      radial-gradient(ellipse 70% 50% at 50% 50%, rgba(56, 189, 248, 0.1), transparent),
      var(--bg-card);
  }

  @media (max-width: 640px) {
    .sync-visual {
      padding: 1.25rem;
    }
  }

  .devices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .device {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 0.5rem;
    border-radius: 14px;
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.03);
    color: var(--accent-light);
  }

  .device span {
    font-size: 0.78rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0.4rem 0;
  }

  .flow-line {
    width: 2px;
    height: 26px;
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    background-size: 100% 200%;
    animation: flow 2.2s linear infinite;
  }

  @keyframes flow {
    from {
      background-position: 0 100%;
    }
    to {
      background-position: 0 -100%;
    }
  }

  .lock {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-light);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.35);
    box-shadow: 0 0 30px -5px var(--accent-glow);
  }

  .backends {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 480px) {
    .backends {
      grid-template-columns: 1fr;
    }
  }

  .backend {
    padding: 0.9rem 1rem;
    border-radius: 14px;
    border: 1px dashed rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .backend-name {
    font-weight: 700;
    font-size: 0.92rem;
  }

  .backend-eg {
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-line {
      animation: none;
    }
  }
</style>
