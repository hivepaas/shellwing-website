---
// TermWindow.astro - a shellwing window drawn in HTML: its tab bar, then the
// slot (panes, a palette) in the terminal theme of the page (--t-*).

interface Tab {
  label: string;
  /** Beside the label, quieter: "prod", "via bastion". */
  sub?: string;
  kind: 'local' | 'ssh';
  active?: boolean;
  /** The dot's state: amber while connecting. */
  connecting?: boolean;
}

interface Props {
  tabs: Tab[];
  /** For screen readers: what the picture shows. */
  label: string;
  class?: string;
}

const { tabs, label, class: className } = Astro.props;
---

<figure class:list={['tw', className]} role="img" aria-label={label}>
  <div class="tw-bar" aria-hidden="true">
    <span class="tw-lights"><i></i><i></i><i></i></span>
    <svg class="tw-wing" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 17c4-1 7-4 9-9 1 4 4 7 9 8-5 1-8 2-9 5-1-3-4-4-9-4z"></path>
    </svg>
    <div class="tw-tabs">
      {
        tabs.map((tab) => (
          <span class:list={['tw-tab', { active: tab.active }]}>
            {tab.kind === 'local' ? (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M4 17l6-5-6-5M12 19h8" />
              </svg>
            ) : (
              <span class:list={['tw-dot', { connecting: tab.connecting }]} />
            )}
            <span class="tw-tab-label">{tab.label}</span>
            {tab.sub && <span class="tw-tab-sub">{tab.sub}</span>}
          </span>
        ))
      }
      <span class="tw-plus">+</span>
    </div>
  </div>
  <div class="tw-body term" aria-hidden="true">
    <slot />
  </div>
</figure>

<style>
  .tw {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0b0f17;
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 0 60px -20px var(--accent-glow);
    text-align: left;
  }

  .tw-bar {
    height: 40px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.6rem 0 0.85rem;
    background: #0f1522;
    border-bottom: 1px solid #1e2736;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: #b6c0cf;
  }

  .tw-lights {
    display: flex;
    gap: 6px;
  }

  .tw-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #334155;
  }

  .tw-lights i:nth-child(1) {
    background: #f87171;
  }
  .tw-lights i:nth-child(2) {
    background: #fbbf24;
  }
  .tw-lights i:nth-child(3) {
    background: #4ade80;
  }

  .tw-wing {
    color: var(--t-accent);
    flex-shrink: 0;
    transition: color 0.4s ease;
  }

  .tw-tabs {
    display: flex;
    align-items: stretch;
    height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .tw-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.85rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .tw-tab.active {
    background: #0b0f17;
    color: #f1f5f9;
    border-bottom-color: var(--t-accent);
    transition: border-color 0.4s ease;
  }

  .tw-tab-sub {
    color: #8a96aa;
    font-size: 0.72rem;
  }

  .tw-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  .tw-dot.connecting {
    background: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
  }

  .tw-plus {
    display: flex;
    align-items: center;
    padding: 0 0.6rem;
    color: #8a96aa;
    font-size: 1rem;
  }

  .tw-body {
    position: relative;
  }

  @media (max-width: 640px) {
    .tw-tab-sub,
    .tw-lights {
      display: none;
    }
    .tw-tab {
      padding: 0 0.55rem;
    }
  }
</style>
