---
// Navbar.astro - the brand, the home page's sections, GitHub
// Links to the home page's sections are absolute (/#features), so they work
// from every page.
import { GITHUB_URL, PRODUCTS, PRODUCT_ID } from '../data/site';

const links = [
  { href: '/#ai', label: 'AI' },
  { href: '/#features', label: 'Features' },
  { href: '/#sync', label: 'Vault & Sync' },
  { href: '/#comparison', label: 'Compare' },
  { href: '/#faq', label: 'FAQ' },
];

// The Products menu shows the hive's other apps, not this one.
const others = PRODUCTS.filter((product) => product.id !== PRODUCT_ID);
---

<header class="navbar-wrapper">
  <div class="container">
    <nav class="navbar">
      <a href="/" class="brand-logo" aria-label="shellwing home">
        <img src="/logo.svg" width="30" height="30" alt="" />
        <span class="brand-name">shell<span class="brand-highlight">wing</span></span>
      </a>

      <div class="nav-links">
        <div class="nav-dropdown" id="productsMenu">
          <button type="button" class="nav-link nav-trigger" id="productsBtn" aria-expanded="false" aria-controls="productsPanel" aria-haspopup="true">
            Products
            <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>

          <div class="dropdown-panel" id="productsPanel" role="menu" aria-labelledby="productsBtn">
            {others.map((product) => (
              <a href={product.href} target="_blank" rel="noopener noreferrer" class="product-item" role="menuitem">
                <img src={product.icon} width="34" height="34" alt="" class="product-icon" />
                <span class="product-text">
                  <span class="product-name">
                    {product.name}
                    <span class="product-tagline">{product.tagline}</span>
                  </span>
                  <span class="product-desc">{product.description}</span>
                </span>
              </a>
            ))}
          </div>
        </div>

        {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
      </div>

      <div class="nav-actions">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-social-btn"
          aria-label="shellwing on GitHub"
          title="GitHub Repository"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span class="social-label">GitHub</span>
        </a>

        <a href="/#get" class="btn btn-primary btn-sm">Download</a>
      </div>

      <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <span class="mobile-heading">Products</span>
    {others.map((product) => (
      <a href={product.href} target="_blank" rel="noopener noreferrer" class="mobile-product">
        <img src={product.icon} width="30" height="30" alt="" class="product-icon" />
        <span class="product-text">
          <span class="product-name">
            {product.name}
            <span class="product-tagline">{product.tagline}</span>
          </span>
          <span class="product-desc">{product.description}</span>
        </span>
      </a>
    ))}

    <span class="mobile-heading">shellwing</span>
    {links.map((link) => <a href={link.href} class="mobile-link">{link.label}</a>)}
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="mobile-link">GitHub</a>
    <a href="/#get" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Download</a>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: rgba(4, 6, 10, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .brand-logo img {
    filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.35));
  }

  .brand-highlight {
    color: var(--accent);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.9rem;
  }

  @media (min-width: 960px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .nav-actions {
      display: flex;
    }
  }

  .nav-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-social-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }

  .btn-sm {
    padding: 0.45rem 1.15rem;
    font-size: 0.85rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  @media (min-width: 960px) and (max-width: 1139px) {
    .nav-links {
      gap: 1.3rem;
    }

    .social-label {
      display: none;
    }
  }

  .mobile-toggle {
    display: block;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (min-width: 960px) {
    .mobile-toggle {
      display: none;
    }
  }

  /* Between the phone menu and a wide screen the toggle and the actions sit
     side by side. */
  @media (min-width: 768px) and (max-width: 959px) {
    .navbar {
      gap: 1rem;
    }
    .nav-actions {
      margin-left: auto;
    }
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: var(--header-height);
    left: 0;
    right: 0;
    background: #080b11;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.5rem;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.5rem 0;
  }
  /* Products menu ------------------------------------------------------- */

  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .nav-dropdown.open .nav-trigger {
    color: var(--text-primary);
  }

  .nav-dropdown.open .chevron {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 1.35rem);
    left: -1.1rem;
    width: 27rem;
    max-width: calc(100vw - 2 * var(--container-gutter));
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  /* Bridges the gap under the trigger, so the pointer can cross into the
     panel without it closing on the way. */
  .dropdown-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 1.35rem;
  }

  .nav-dropdown.open .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .product-item {
    display: flex;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-item:hover,
  .product-item:focus-visible {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-hover);
    outline: none;
  }

  .product-icon {
    flex-shrink: 0;
    border-radius: 9px;
    margin-top: 0.1rem;
  }

  .product-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .product-name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .product-tagline {
    color: var(--accent-light);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .product-desc {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  /* The phone menu's two groups */
  .mobile-heading {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .mobile-product {
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
  }

</style>
<script>
  // The Products menu: a click opens and closes it, a pointer opens it on the
  // way past, and Escape or a click outside closes it again.
  const productsMenu = document.getElementById('productsMenu');
  const productsBtn = document.getElementById('productsBtn');

  if (productsMenu && productsBtn) {
    const setOpen = (open: boolean) => {
      productsMenu.classList.toggle('open', open);
      productsBtn.setAttribute('aria-expanded', String(open));
    };

    productsBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!productsMenu.classList.contains('open'));
    });

    // Only where there is a real pointer: on a touch screen the click above
    // does the work, and a hover would open the menu on the tap that follows.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      productsMenu.addEventListener('mouseenter', () => setOpen(true));
      productsMenu.addEventListener('mouseleave', () => setOpen(false));
    }

    productsMenu.addEventListener('focusout', (event) => {
      if (!productsMenu.contains(event.relatedTarget as Node)) setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (!productsMenu.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && productsMenu.classList.contains('open')) {
        setOpen(false);
        productsBtn.focus();
      }
    });
  }
</script>


<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', String(open));
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
